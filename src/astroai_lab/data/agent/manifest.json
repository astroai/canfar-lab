      "description": "OpenCode config + LSP (~/.config/opencode/)"
    },
    "goose": {
      "description": "Goose MCP extensions (~/.config/goose/config.yaml)"
    },
    "kilo": {
      "description": "Kilo CLI starter config (~/.config/kilo/kilo.jsonc)"
    },
    "cline": {
      "description": "Cline CLI notes (~/.config/cline/cline-notes.md)"
    },
    "codewhale": {
      "description": "CodeWhale starter config (~/.codewhale/config.toml)"
    },
    "pi": {
      "description": "Pi settings + OpenRouter auth (~/.pi/agent/)"
    },
    "omp": {
      "description": "Oh My Pi CANFAR notes (~/.config/omp/astroai-notes.md)"
    },
    "freebuff": {
      "description": "Freebuff CANFAR notes (~/.config/freebuff/astroai-notes.md)"
    },
    "qoder": {
      "description": "Qoder CLI CANFAR notes (~/.config/qoder/astroai-notes.md)"
