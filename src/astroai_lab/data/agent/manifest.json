    "swival": {
      "description": "Swival CANFAR notes (~/.config/swival/astroai-notes.md)"
    },
    "zcode": {
      "description": "ZCode CLI CANFAR notes (~/.config/zcode/astroai-notes.md)"
    },
    "codex": {
      "description": "Codex CLI MCP (~/.codex/config.toml)"
    },
    "copilot": {
      "description": "GitHub Copilot CLI MCP (~/.copilot/mcp-config.json)"
