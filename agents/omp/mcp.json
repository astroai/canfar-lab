{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${HOME}/.local/share/agent-home/memory.jsonl"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "overleaf": {
      "command": "npx",
      "args": [
        "-y",
        "@mjyoo2/overleaf-mcp"
      ],
      "env": {
        "OVERLEAF_PROJECTS_CONFIG": "${HOME}/.config/overleaf-mcp/projects.json"
      }
    }
  }
}
